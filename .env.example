# Application
NEXT_PUBLIC_APP_NAME=SIPelan
NEXT_PUBLIC_APP_URL=http://localhost:5000

# PostgreSQL Database (REQUIRED)
DATABASE_URL=postgresql://user:password@localhost:5432/sipelan
# Optional SSL mode for hosted Postgres (set to require if needed)
PGSSLMODE=disable

# File Storage (local)
# Files will be stored under UPLOAD_DIR and served from FILE_BASE_URL
UPLOAD_DIR=uploads
FILE_BASE_URL=http://localhost:5000/uploads

# Email Notification (OPTIONAL - for sending email to pelapor)
# If not configured, email will only be logged to console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_or_api_key
SMTP_FROM="SIPelan" <noreply@sipelan.go.id>

# Email Examples:
# Gmail: smtp.gmail.com, port 587, secure=false
# Outlook: smtp-mail.outlook.com, port 587, secure=false
# SendGrid: smtp.sendgrid.net, port 587, secure=false
# AWS SES: email-smtp.region.amazonaws.com, port 587, secure=false

# JWT Secret (for authentication)
JWT_SECRET=your_secret_key_here_minimum_32_characters

# Google reCAPTCHA v3 (REQUIRED for form spam protection)
# Get your keys from: https://www.google.com/recaptcha/admin/create
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Node Environment
NODE_ENV=development
